{
    "name": "bagisto-myfatoorah-e2e",
    "version": "2.4.11",
    "private": true,
    "description": "Playwright suite for the Bagisto MyFatoorah payment gateway, run against a MyFatoorah mock so no real payment is ever made.",
    "scripts": {
        "install:browsers": "playwright install --with-deps chromium",
        "mock": "node mock/myfatoorah-mock.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "test:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.0",
        "@types/node": "^22.10.0",
        "dotenv": "^16.4.7",
        "prettier": "^3.8.2",
        "typescript": "^5.7.2"
    }
}
